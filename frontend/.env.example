# ==========================================================================
# Frontend (Next.js / NextAuth) - variables de entorno
# Copiar a `.env.local` y completar. NUNCA commitear el .env.local real.
# OJO: acá NO va SECRET_KEY (esa es del backend, va en backend/.env o Railway).
# ==========================================================================

# URL pública del backend (FastAPI).
#   Local:      http://localhost:8000
#   Producción: https://tu-backend.up.railway.app
NEXT_PUBLIC_API_URL=http://localhost:8000

# Google OAuth (el MISMO Client ID/Secret que usa el backend).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NextAuth. NEXTAUTH_URL = la URL del propio frontend.
#   Local:      http://localhost:3000
#   Producción: https://tu-front.vercel.app
NEXTAUTH_URL=http://localhost:3000
# Secreto propio de NextAuth (distinto del SECRET_KEY del backend).
# Generar con: openssl rand -base64 32
NEXTAUTH_SECRET=
