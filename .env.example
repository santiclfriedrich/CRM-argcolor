# ==========================================================================
# CRM Comercial ARG COLOR - Variables de entorno
# Copiar a .env y completar con valores reales. NUNCA commitear el .env real.
# ==========================================================================

# --- Backend ---
# En local con docker-compose se usa el Postgres del contenedor (ver docker-compose.yml).
# Para Supabase (Render/producción) usar el Session Pooler con prefijo +psycopg:
# postgresql+psycopg://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/argcolor

# Clave para firmar JWT (generar con: openssl rand -hex 32)
SECRET_KEY=changeme-generar-con-openssl
# Vida del JWT del backend en minutos (480 = 8 h). Alinear con session.maxAge de NextAuth.
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- IA ---
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- Google OAuth (mismo Client ID/Secret en backend y frontend) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Gmail / Pub-Sub ---
GMAIL_TOPIC_NAME=

# --- CORS (orígenes permitidos, separados por coma) ---
ALLOWED_ORIGINS=http://localhost:3000,https://argcolor-crm.vercel.app

# --- Frontend (NextAuth) ---
NEXTAUTH_URL=http://localhost:3000
# Generar con: openssl rand -base64 32
NEXTAUTH_SECRET=changeme-generar-con-openssl
NEXT_PUBLIC_API_URL=http://localhost:8000
