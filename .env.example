# ==========================================================================
# CRM Comercial ARG COLOR - Variables de entorno
# Copiar a .env y completar con valores reales. NUNCA commitear el .env real.
# ==========================================================================

# --- Backend ---
# En local con docker-compose se usa el Postgres del contenedor (ver docker-compose.yml).
# Para Supabase (Render/producción) usar el Session Pooler con prefijo +psycopg:
# postgresql+psycopg://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/argcolor

# Clave para firmar JWT (generar con: openssl rand -hex 32)
SECRET_KEY=changeme-generar-con-openssl
# Vida del JWT del backend en minutos (480 = 8 h). Alinear con session.maxAge de NextAuth.
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- IA ---
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Google OAuth (mismo Client ID/Secret en backend y frontend) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Gmail / Pub-Sub ---
GMAIL_TOPIC_NAME=

# --- Gmail polling (Camino A: OAuth refresh token de la casilla comercial) ---
# GMAIL_ENABLED=true activa el job de polling. Generá el refresh token con:
#   python -m scripts.gmail_authorize   (requiere GMAIL_CLIENT_ID/SECRET de un OAuth "Desktop app")
GMAIL_ENABLED=false
GMAIL_USER=ventas@argentinacolor.com
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Enfoque B: la query final se arma sola con los dominios de clientes cargados
# en el CRM + la etiqueta comodín. GMAIL_QUERY es solo la ventana temporal base
# y GMAIL_LABEL la etiqueta para prospectos nuevos sin dominio cargado. Resultado:
#   newer_than:2d (label:crm OR from:cliente1.com OR from:cliente2.com ...)
GMAIL_QUERY=newer_than:2d
GMAIL_LABEL=crm
GMAIL_POLL_INTERVAL_SECONDS=120
# Camino B (multi-casilla): ruta al JSON de la service account con delegation.
# Si está seteado, se ignora el refresh token y se leen las casillas de todos
# los usuarios activos (impersonación). Requiere que un admin autorice el
# Client ID de la service account en admin.google.com (domain-wide delegation).
GMAIL_SERVICE_ACCOUNT_FILE=
# El acuse/aclaración automáticos se configuran desde la UI (Configuración),
# se guardan en la tabla `configuracion`. No hace falta variable de entorno.

# --- CORS (orígenes permitidos, separados por coma) ---
ALLOWED_ORIGINS=http://localhost:3000,https://argcolor-crm.vercel.app

# --- Frontend (NextAuth) ---
NEXTAUTH_URL=http://localhost:3000
# Generar con: openssl rand -base64 32
NEXTAUTH_SECRET=changeme-generar-con-openssl
NEXT_PUBLIC_API_URL=http://localhost:8000
